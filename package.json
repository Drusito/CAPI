{
  "name": "capitalista",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run web\"",
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "build": "npx expo export --platform web --output-dir dist",
    "serve": "tsx server/index.ts",
    "server": "tsx watch server/index.ts",
    "mobile": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 3000"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "crypto-browserify": "^3.12.1",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.1",
    "express": "^4.19.2",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.74.5",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "^0.19.10",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "stream-browserify": "^3.0.0",
    "vm-browserify": "^1.1.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "~18.2.45",
    "concurrently": "^8.2.2",
    "tsx": "^4.11.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
